# GigaChat (личный кабинет разработчика Sber)
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# На PERS сейчас доступны GigaChat-2 / 2-Pro / 2-Max (не GigaChat-3-Ultra)
GIGACHAT_MODEL=GigaChat-2-Max

# SingularityApp (личный кабинет → Доступ к API)
SINGULARITY_API_TOKEN=
SINGULARITY_API_BASE_URL=https://api.singularity-app.com

# App
APP_TIMEZONE=Europe/Moscow
LOG_LEVEL=INFO
SERVER_PORT=8080
SERVER_SERVLET_CONTEXT_PATH=/singularity
APP_CLI_ENABLED=false

# Алиса (session.user.user_id из запроса Диалогов, через запятую)
ALICE_ALLOWED_USER_IDS=
ALICE_GREETING="Поставьте Диме новую задачу"

